loki.write "prod" {
    endpoint {
        url = env("GCLOUD_HOSTED_LOGS_URL")
        basic_auth {
            username = env("GCLOUD_HOSTED_LOGS_ID")
            password = env("GCLOUD_RW_API_KEY")
        }
    }
}

discovery.docker "api_containers" {
    host = "unix:///var/run/docker.sock"
    refresh_interval = "15s"

    // 종료된(이전 blue/green) 컨테이너는 추적하지 않도록 running 상태만 필터.
    // → 배포 시 alloy가 죽은 컨테이너에 고정되지 않고 항상 활성 컨테이너 로그를 수집한다.
    filter {
        name = "status"
        values = ["running"]
    }
    filter {
        name = "name"
        values = ["estime-api-blue", "estime-api-green"]
    }
}

loki.source.docker "estime_api_logs" {
    host = "unix:///var/run/docker.sock"
    targets = discovery.docker.api_containers.targets
    forward_to = [loki.relabel.add_api_labels.receiver]
}

loki.relabel "add_api_labels" {
    forward_to = [loki.write.prod.receiver]

    rule {
        target_label = "job"
        replacement = "estime-api-prod"
    }
    rule {
        target_label = "app"
        replacement = "estime-api-prod"
    }
    rule {
        target_label = "env"
        replacement = "prod"
    }
    rule {
        source_labels = ["__meta_docker_container_name"]
        regex = "/(.*)"
        target_label = "container"
    }
}

prometheus.scrape "estime_api_metrics_blue" {
    targets = [{
        __address__ = "estime-api-blue:8080",
        job = "estime-api-prod",
        env = "prod",
        deployment = "blue",
    }]

    forward_to = [prometheus.relabel.add_metrics_labels.receiver]
    scrape_interval = "15s"
    metrics_path = "/actuator/prometheus"
}

prometheus.scrape "estime_api_metrics_green" {
    targets = [{
        __address__ = "estime-api-green:8080",
        job = "estime-api-prod",
        env = "prod",
        deployment = "green",
    }]

    forward_to = [prometheus.relabel.add_metrics_labels.receiver]
    scrape_interval = "15s"
    metrics_path = "/actuator/prometheus"
}

prometheus.relabel "add_metrics_labels" {
    forward_to = [prometheus.remote_write.prod.receiver]

    rule {
        source_labels = ["__address__"]
        target_label = "instance"
    }
}

prometheus.remote_write "prod" {
    endpoint {
        url = env("GCLOUD_HOSTED_METRICS_URL")
        basic_auth {
            username = env("GCLOUD_HOSTED_METRICS_ID")
            password = env("GCLOUD_RW_API_KEY")
        }
    }
}
